#!/usr/bin/env bash
# gator-unit <store> <slug> <dir> <cmd> <timeout> <title> [verify] [record] [scope]
#
# Runs one delegated unit to completion, detached from whoever started it, then
# commits what the worker produced and — the point of auto-merge-on-green —
# verifies it *inside the worktree* before anyone merges anything.
set -uo pipefail
STORE="$1"; SLUG="$2"; DIR="$3"; CMD="$4"; TMO="$5"; TITLE="$6"; VERIFY="${7:-}"; RECORD="${8:-}"
SCOPE="${9:-}"
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
START=$(date +%s)
BASE_SHA=$(git -C "$DIR" rev-parse HEAD 2>/dev/null || echo "")
REPO="$(dirname "$STORE")"

# The lease was taken before this process existed, so it has no pid to check
# liveness against until now. Claiming it closes the window in which a crash
# here would look like a launch that never happened.
python3 "$HERE/gator-sched.py" adopt --store "$STORE" --slug "$SLUG" --pid $$ 2>/dev/null || true

# Whatever happens below — a clean finish, a timeout, a kill — the backend must
# not stay claimed by a process that is gone.
release_slot(){
  python3 "$HERE/gator-sched.py" release --store "$STORE" --slug "$SLUG" 2>/dev/null || true
}
trap release_slot EXIT

( cd "$DIR" && timeout "$TMO" bash -c "$CMD" < "$STORE/$SLUG.prompt" ) > "$STORE/$SLUG.log" 2>&1
WRC=$?

# The worker may finish without committing; keep whatever it left behind.
if [ -n "$(git -C "$DIR" status --porcelain 2>/dev/null)" ]; then
  git -C "$DIR" add -A 2>/dev/null
  git -C "$DIR" -c user.email=delegate@local -c user.name=delegate commit -qm "$TITLE" 2>/dev/null
fi

# Whether anything was committed is a fact about the branch, not about how the
# commit got there: the worker may have committed on its own.
COMMIT_SHA=$(git -C "$DIR" rev-parse HEAD 2>/dev/null || echo "")
AHEAD=$(git -C "$DIR" rev-list --count "$BASE_SHA..HEAD" 2>/dev/null || echo 0)
COMMITTED=false; [ "$AHEAD" -gt 0 ] 2>/dev/null && COMMITTED=true

# Scope, before verification: a unit that wrote outside the area it declared
# is not made acceptable by a green build, and "it wrote where it should not"
# is the more actionable fact to report (spec section 7).
SCOPE_JSON=$(python3 "$HERE/gator-scope.py" "$DIR" "$BASE_SHA" "$SCOPE" 2>/dev/null)
[ -n "$SCOPE_JSON" ] || SCOPE_JSON='{"checked":false,"changed":0,"violations":[]}'

# Verification runs in the worktree, never in the caller's tree: a broken unit
# must cost a merge that never happened, not a rollback of someone's work. The
# verified SHA is captured before the run, so the result is bound to the tree
# that was actually tested (spec section 7).
VRC=-1
VERIFIED_SHA=""
if [ -n "$VERIFY" ]; then
  VERIFIED_SHA="$COMMIT_SHA"
  ( cd "$DIR" && timeout "${GATOR_VERIFY_TIMEOUT:-900}" bash -c "$VERIFY" ) > "$STORE/$SLUG.verify" 2>&1
  VRC=$?
fi

ELAPSED=$(( $(date +%s) - START ))

# .done keeps its three original fields: other readers still depend on it.
python3 -c 'import json,sys
json.dump({"rc":int(sys.argv[2]),"elapsed":int(sys.argv[3]),"verify_rc":int(sys.argv[4])},
          open(sys.argv[1],"w"))' "$STORE/$SLUG.done" "$WRC" "$ELAPSED" "$VRC"

if [ -n "$RECORD" ]; then
  python3 "$HERE/gator-record.py" write "$RECORD" \
    "worker.launch_error=false" "worker.rc=$WRC" "worker.elapsed=$ELAPSED" \
    "result.committed=$COMMITTED" "result.commit_sha=$COMMIT_SHA" "result.ahead=$AHEAD" \
    "verify.rc=$VRC" "verify.verified_sha=$VERIFIED_SHA"
  python3 "$HERE/gator-record.py" merge "$RECORD" scope "$SCOPE_JSON"
fi
# Logs and verifier output carry whatever the worker and the tests printed.
chmod 600 "$STORE/$SLUG."* 2>/dev/null || true

# Hand the slot on before dropping the lock, not after. A unit waiting for this
# backend should start here rather than at whenever someone next runs `status`
# — that is what keeps the other GPU from idling. Doing it in this order also
# means `gator wait` never sees a moment with no locks while work remains: the
# successor has taken its own lock before this one lets go.
release_slot
trap - EXIT
( cd "$REPO" && "$HERE/gator" drain >/dev/null 2>&1 ) || true

rm -f "$STORE/$SLUG.lock"
